JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

LEGACY_PASSWORD_ALGO=auto

LEGACY_PASSWORD_REHASH=false

INTERNAL_API_SECRET=

UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10
LEGACY_UPLOAD_DIR=
GOOGLE_MAPS_API_KEY=
LOG_LEVEL=info
