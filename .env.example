# ---------------------------------------------------------------------------
# Capital Link Services API
#
# Copy to `.env` and fill in. Every variable is read exactly once, in
# `src/config/env.ts`, which validates the set on boot and refuses to start
# rather than failing later on the first request that needed a missing value.
# ---------------------------------------------------------------------------

# --- HTTP -------------------------------------------------------------------
PORT=5000
NODE_ENV=development

# Origins allowed to call this API from a browser, comma separated.
# The website talks to the API from its own server, so this list only matters
# for direct browser calls and for local tooling.
ALLOWED_ORIGINS=http://localhost:3000

# --- Database ---------------------------------------------------------------
# The existing CLS database. Its schema is FIXED: this application issues no
# DDL of any kind, and `sequelize.sync()` is never called. Give the account
# below SELECT/INSERT/UPDATE only — no CREATE, ALTER or DROP — so that a
# mistake in this codebase becomes a failed query rather than a changed table.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=clspubli_staging
DB_USER=cls_api
DB_PASSWORD=

# Most legacy tables are latin1; a few are utf8. Connecting as utf8mb4 lets
# MySQL convert on the way out, so the API always hands back valid UTF-8.
DB_CHARSET=utf8mb4

# The legacy application writes local Sydney times into DATETIME columns with
# no zone attached. Reading them back in the same zone is what stops every
# timestamp shifting by ten hours.
DB_TIMEZONE=+10:00

DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_IDLE_MS=10000
DB_POOL_ACQUIRE_MS=30000

# Logs every statement the API runs. Useful while mapping legacy tables;
# noisy enough that it should stay off otherwise.
DB_LOG_QUERIES=false

# Hard read-only mode. With this on, every INSERT/UPDATE/DELETE is refused by
# the application before it reaches MySQL. Keep it on for the read-only
# milestone so a mapping mistake cannot touch five years of live records.
DB_READ_ONLY=false

# --- Authentication ---------------------------------------------------------
# Signing key for access tokens. Must be at least 32 characters.
JWT_SECRET=
JWT_EXPIRES_IN=1h

# Separate key for refresh tokens, so a leaked access-token key cannot be used
# to mint new sessions.
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

# How `tbl_user_client.password` and `tbl_user_admin.password` are hashed in
# the live database. `auto` detects bcrypt, then MD5, then SHA-1 by the shape
# of the stored value, and re-hashes to bcrypt on the next successful sign-in.
# Set it explicitly once you know: bcrypt | md5 | sha1 | sha256 | auto
LEGACY_PASSWORD_ALGO=auto

# Whether a successful legacy-hash sign-in upgrades the stored hash to bcrypt.
# Requires write access, and changes a column the old application also reads —
# leave it off until the old app is confirmed bcrypt-compatible or retired.
LEGACY_PASSWORD_REHASH=false

# --- Server-to-server -------------------------------------------------------
# Shared with the website. The Stripe webhook uses it to tell this API that a
# payment landed. Must match INTERNAL_API_SECRET in the website's env.
INTERNAL_API_SECRET=

# --- Uploads ----------------------------------------------------------------
# Where new uploads are written. Legacy documents are read from the path the
# old application recorded in the database, resolved under LEGACY_UPLOAD_DIR.
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# Root the legacy application's stored file paths are relative to. Leave blank
# until the live document directory is mounted; downloads of legacy files then
# answer 404 instead of reading an unintended path.
LEGACY_UPLOAD_DIR=

# --- Integrations -----------------------------------------------------------
# Unset: the address lookup switches off and the forms fall back to manual entry.
GOOGLE_MAPS_API_KEY=

# --- Logging ----------------------------------------------------------------
# error | warn | info | debug
LOG_LEVEL=info
