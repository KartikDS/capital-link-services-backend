
PORT=5000
NODE_ENV=development

ALLOWED_ORIGINS=http://localhost:3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=clspubli_staging
DB_USER=cls_api
DB_PASSWORD=


DB_CHARSET=utf8mb4


DB_TIMEZONE=+10:00

DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_IDLE_MS=10000
DB_POOL_ACQUIRE_MS=30000

DB_LOG_QUERIES=false

DB_READ_ONLY=false

JWT_SECRET=
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

LEGACY_PASSWORD_ALGO=auto

LEGACY_PASSWORD_REHASH=false

INTERNAL_API_SECRET=

UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10
LEGACY_UPLOAD_DIR=
GOOGLE_MAPS_API_KEY=
LOG_LEVEL=info

# --- Document storage (S3) ---------------------------------------------------
# Client documents (order attachments, passport photos) are written to this
# bucket as soon as all four of S3_BUCKET, S3_REGION, S3_ACCESS_KEY_ID and
# S3_SECRET_ACCESS_KEY are set. Until then they are written under UPLOAD_DIR on
# this machine, and GET /api/system/ready reports which is in force.
#
# Reads always try the bucket first, then UPLOAD_DIR, then LEGACY_UPLOAD_DIR, so
# documents uploaded before the bucket was configured keep downloading.
S3_BUCKET=cls-staging
S3_REGION=avvc
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Only for an S3-compatible provider. Leave empty for AWS's own endpoint.
S3_ENDPOINT=
# bucket/key in the path rather than bucket. in the host. Most non-AWS need true.
S3_FORCE_PATH_STYLE=false
# Optional key prefix, so one bucket can hold more than this deployment.
# Set it once: changing it later does not move the objects already written.
S3_PREFIX=
